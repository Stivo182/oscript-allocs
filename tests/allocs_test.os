&Тест
Процедура ТестДолжен_ПоддержатьАнглийскиеИменаAPI() Экспорт

	// Подготовка
	МониторПамяти = Новый MemoryMonitor();

	// Действие
	РазмерКучи = МониторПамяти.HeapSize();
	ВсегоДо = МониторПамяти.TotalAllocatedBytes();
	МониторПамяти.Start();
	ВыделеноБайт = МониторПамяти.Stop();
	ВсегоПосле = МониторПамяти.TotalAllocatedBytes();

	// Утверждение
	Ожидаем.Что(РазмерКучи).Больше(0);
	Ожидаем.Что(ВсегоПосле).БольшеИлиРавно(ВсегоДо);
	Ожидаем.Что(ВыделеноБайт).БольшеИлиРавно(0);

КонецПроцедуры

Функция Медиана(Значения)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");

	Для Каждого Значение Из Значения Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Значение = Значение;
	КонецЦикла;

	Таблица.Сортировать("Значение Возр");

	Возврат Таблица[Цел(Таблица.Количество() / 2)].Значение;

КонецФункции

Функция ИзмеритьМедиануАллокацииБуфера(Размер, КоличествоОпераций, КоличествоПовторов)

	Результаты = Новый Массив;

	Для НомерПовтора = 1 По КоличествоПовторов Цикл
		МониторПамяти = Новый МониторПамяти();
		МониторПамяти.Начать();
		Для НомерОперации = 1 По КоличествоОпераций Цикл
			Буфер = NULL;
		КонецЦикла;
		ПустойИнтервал = МониторПамяти.Завершить();

		МониторПамяти.Начать();
		Для НомерОперации = 1 По КоличествоОпераций Цикл
			Буфер = Новый БуферДвоичныхДанных(Размер);
		КонецЦикла;
		ИнтервалСАллокацией = МониторПамяти.Завершить();
		Результаты.Добавить((ИнтервалСАллокацией - ПустойИнтервал) / КоличествоОпераций);
		Буфер = NULL;
	КонецЦикла;

	Возврат Медиана(Результаты);

КонецФункции
