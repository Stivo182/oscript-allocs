&Тест
Процедура ТестДолжен_ИзмеритьПустойИнтервал() Экспорт

	// Подготовка
	Результаты = Новый Массив;

	// Действие
	Для НомерПовтора = 1 По 5 Цикл
		МониторПамяти = Новый МониторПамяти();
		МониторПамяти.Начать();
		Результаты.Добавить(МониторПамяти.Завершить());
	КонецЦикла;

	// Утверждение
	Ожидаем.Что(Медиана(Результаты)).Между(0, 50);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзмеритьМалыеАллокации() Экспорт

	// Подготовка
	Размер = 1024;
	КоличествоОпераций = 1000;
	КоличествоПовторов = 5;
	ПустыеИнтервалы = Новый Массив;
	ИнтервалыСАллокациями = Новый Массив;
	НакладныеРасходы = 400;

	// Действие
	Для НомерПовтора = 1 По КоличествоПовторов Цикл
		МониторПамяти = Новый МониторПамяти();
		МониторПамяти.Начать();
		ПустыеИнтервалы.Добавить(МониторПамяти.Завершить());

		МониторПамяти.Начать();
		Для НомерОперации = 1 По КоличествоОпераций Цикл
			Буфер = Новый БуферДвоичныхДанных(Размер);
		КонецЦикла;
		ИнтервалыСАллокациями.Добавить(МониторПамяти.Завершить());
	КонецЦикла;

	Baseline = Медиана(ПустыеИнтервалы);
	БайтНаОперацию = (Медиана(ИнтервалыСАллокациями) - Baseline) / КоличествоОпераций;

	// Утверждение
	Ожидаем.Что(БайтНаОперацию).Между(Размер, Размер + НакладныеРасходы);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзмеритьАллокацииБуферовРазногоРазмера() Экспорт

	// Подготовка
	КоличествоПовторов = 5;
	НакладныеРасходы = 400;

	Сценарии = Новый ТаблицаЗначений;
	Сценарии.Колонки.Добавить("Размер");
	Сценарии.Колонки.Добавить("КоличествоОпераций");
	Сценарий = Сценарии.Добавить();
	Сценарий.Размер = 1024;
	Сценарий.КоличествоОпераций = 1000;

	Сценарий = Сценарии.Добавить();
	Сценарий.Размер = 1024 * 1024;
	Сценарий.КоличествоОпераций = 1;

	Сценарий = Сценарии.Добавить();
	Сценарий.Размер = 10 * 1024 * 1024;
	Сценарий.КоличествоОпераций = 1;

	// Действие и утверждение
	Для Каждого Сценарий Из Сценарии Цикл
		ВыделеноБайт = ИзмеритьМедиануАллокацииБуфера(
			Сценарий.Размер,
			Сценарий.КоличествоОпераций,
			КоличествоПовторов);
		Ожидаем.Что(ВыделеноБайт).Между(Сценарий.Размер, Сценарий.Размер + НакладныеРасходы);
	КонецЦикла;

КонецПроцедуры

