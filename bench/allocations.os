#Использовать ".."

Функция ПовторитьСимвол(Символ, Количество)

	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДополнитьСправа(Значение, Ширина)

	Текст = Строка(Значение);
	Недостаёт = Ширина - СтрДлина(Текст);
	Если Недостаёт < 0 Тогда
		Недостаёт = 0;
	КонецЕсли;
	Возврат Текст + ПовторитьСимвол(" ", Недостаёт);

КонецФункции

Функция ДополнитьСлева(Значение, Ширина)

	Текст = Строка(Значение);
	Недостаёт = Ширина - СтрДлина(Текст);
	Если Недостаёт < 0 Тогда
		Недостаёт = 0;
	КонецЕсли;
	Возврат ПовторитьСимвол(" ", Недостаёт) + Текст;

КонецФункции

Функция ЦелоеЧисло(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0");
КонецФункции

Функция ЗнаковоеЦелое(Значение)

	Префикс = ?(Значение > 0, "+", "");
	Возврат Префикс + ЦелоеЧисло(Значение);

КонецФункции

Функция ЗнаковыйПроцент(Значение)

	Префикс = ?(Значение > 0, "+", "");
	Возврат Префикс + Формат(Значение, "ЧГ=0; ЧДЦ=2; ЧН=0");

КонецФункции

Функция НоваяВыборка()

	Выборка = Новый ТаблицаЗначений;
	Выборка.Колонки.Добавить("Значение");
	Возврат Выборка;

КонецФункции

Процедура ДобавитьВВыборку(Выборка, Значение)

	СтрокаВыборки = Выборка.Добавить();
	СтрокаВыборки.Значение = Значение;

КонецПроцедуры

Функция Статистика(Выборка)

	Выборка.Сортировать("Значение Возр");
	Количество = Выборка.Количество();
	ЛевыйИндекс = Цел((Количество - 1) / 2);
	ПравыйИндекс = Цел(Количество / 2);
	Медиана = (Выборка[ЛевыйИндекс].Значение + Выборка[ПравыйИндекс].Значение) / 2;

	Возврат Новый Структура(
		"Медиана,Минимум,Максимум",
		Медиана,
		Выборка[0].Значение,
		Выборка[Количество - 1].Значение);

КонецФункции

Функция Скорректировать(Измерено, Baseline)

	Результат = Измерено - Baseline;
	Если Результат < 0 Тогда
		Результат = 0;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура Прогреть()

	Монитор = Новый МониторПамяти();

	Для Номер = 1 По 10 Цикл
		Монитор.Начать();
		Буфер = Новый БуферДвоичныхДанных(1024);
		Монитор.Завершить();
	КонецЦикла;

	Монитор.Начать();
	Для Номер = 1 По 1000 Цикл
		Буфер = Новый БуферДвоичныхДанных(1024);
	КонецЦикла;
	Монитор.Завершить();

	Текст = "";
	МассивСтрок = Новый Массив;
	Для Номер = 1 По 10 Цикл
		Текст = Текст + "0123456789";
		МассивСтрок.Добавить("0123456789");
	КонецЦикла;
	СоединённыйТекст = СтрСоединить(МассивСтрок, "");

	Буфер = NULL;
	Текст = NULL;
	МассивСтрок = NULL;
	СоединённыйТекст = NULL;

КонецПроцедуры

Функция ИзмеритьПустойИнтервал(Повторов)

	Выборка = НоваяВыборка();
	Монитор = Новый МониторПамяти();

	Для Номер = 1 По Повторов Цикл
		Монитор.Начать();
		ДобавитьВВыборку(Выборка, Монитор.Завершить());
	КонецЦикла;

	Возврат Выборка;

КонецФункции

Функция ИзмеритьОдиночныйБуфер(Размер, Повторов)

	Выборка = НоваяВыборка();
	Монитор = Новый МониторПамяти();

	Для Номер = 1 По Повторов Цикл
		Монитор.Начать();
		Baseline = Монитор.Завершить();

		Монитор.Начать();
		Буфер = Новый БуферДвоичныхДанных(Размер);
		Измерено = Монитор.Завершить();

		ДобавитьВВыборку(Выборка, Скорректировать(Измерено, Baseline));
		Буфер = NULL;
	КонецЦикла;

	Возврат Выборка;

КонецФункции

Функция ИзмеритьДваБуфера(Размер, Повторов)

	Выборка = НоваяВыборка();
	Монитор = Новый МониторПамяти();

	Для Номер = 1 По Повторов Цикл
		Монитор.Начать();
		Baseline = Монитор.Завершить();

		Монитор.Начать();
		Буфер1 = Новый БуферДвоичныхДанных(Размер);
		Буфер2 = Новый БуферДвоичныхДанных(Размер);
		Измерено = Монитор.Завершить();

		ДобавитьВВыборку(Выборка, Скорректировать(Измерено, Baseline));
		Буфер1 = NULL;
		Буфер2 = NULL;
	КонецЦикла;

	Возврат Выборка;

КонецФункции

