КонецФункции

Функция ИзмеритьПятьБуферов(Размер, Повторов)

	Выборка = НоваяВыборка();
	Монитор = Новый МониторПамяти();

	Для Номер = 1 По Повторов Цикл
		Монитор.Начать();
		Baseline = Монитор.Завершить();

		Монитор.Начать();
		Буфер1 = Новый БуферДвоичныхДанных(Размер);
		Буфер2 = Новый БуферДвоичныхДанных(Размер);
		Буфер3 = Новый БуферДвоичныхДанных(Размер);
		Буфер4 = Новый БуферДвоичныхДанных(Размер);
		Буфер5 = Новый БуферДвоичныхДанных(Размер);
		Измерено = Монитор.Завершить();

		ДобавитьВВыборку(Выборка, Скорректировать(Измерено, Baseline));
		Буфер1 = NULL;
		Буфер2 = NULL;
		Буфер3 = NULL;
		Буфер4 = NULL;
		Буфер5 = NULL;
	КонецЦикла;

	Возврат Выборка;

КонецФункции

Функция ИзмеритьСериюМалыхБуферов(Размер, Операций, Повторов)

	Выборка = НоваяВыборка();
	Монитор = Новый МониторПамяти();

	Для НомерПовтора = 1 По Повторов Цикл
		Монитор.Начать();
		Для НомерОперации = 1 По Операций Цикл
			ПустаяПеременная = НомерОперации;
		КонецЦикла;
		Baseline = Монитор.Завершить();

		Монитор.Начать();
		Для НомерОперации = 1 По Операций Цикл
			Буфер = Новый БуферДвоичныхДанных(Размер);
		КонецЦикла;
		Измерено = Монитор.Завершить();

		ДобавитьВВыборку(Выборка, Скорректировать(Измерено, Baseline));
		Буфер = NULL;
	КонецЦикла;

	Возврат Выборка;

КонецФункции

Процедура ДобавитьРезультат(Результаты, Сценарий, Ожидалось, Повторов, Выборка)

	Агрегат = Статистика(Выборка);
	СтрокаРезультата = Результаты.Добавить();
	СтрокаРезультата.Сценарий = Сценарий;
	СтрокаРезультата.Ожидалось = Ожидалось;
	СтрокаРезультата.Медиана = Агрегат.Медиана;
	Если Ожидалось = Неопределено Тогда
		СтрокаРезультата.Отклонение = Неопределено;
		СтрокаРезультата.Процент = Неопределено;
	Иначе
		СтрокаРезультата.Отклонение = Агрегат.Медиана - Ожидалось;
		СтрокаРезультата.Процент = ?(
			Ожидалось = 0,
			Неопределено,
			100 * СтрокаРезультата.Отклонение / Ожидалось);
	КонецЕсли;
	СтрокаРезультата.Минимум = Агрегат.Минимум;
	СтрокаРезультата.Максимум = Агрегат.Максимум;
	СтрокаРезультата.Повторов = Повторов;

КонецПроцедуры

Функция ВыполнитьИзмерения()

	ФрагментСтроки = "0123456789";
	ОперацийСоСтроками = 1000;
	// Один символ строки CLR занимает 2 байта UTF-16. При последовательной
	// конкатенации на каждой операции создаётся строка увеличенного размера.
	ОжидаетсяКонкатенацией = 2 * СтрДлина(ФрагментСтроки)
		* ОперацийСоСтроками * (ОперацийСоСтроками + 1) / 2;
	// Подготовка массива выполняется вне замера, ожидается payload итоговой строки.
	ОжидаетсяСоединением = 2 * СтрДлина(ФрагментСтроки) * ОперацийСоСтроками;

	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("Сценарий");
	Результаты.Колонки.Добавить("Ожидалось");
	Результаты.Колонки.Добавить("Медиана");
	Результаты.Колонки.Добавить("Отклонение");
	Результаты.Колонки.Добавить("Процент");
	Результаты.Колонки.Добавить("Минимум");
	Результаты.Колонки.Добавить("Максимум");
	Результаты.Колонки.Добавить("Повторов");

	ДобавитьРезультат(Результаты, "empty", 0, 30, ИзмеритьПустойИнтервал(30));
	ДобавитьРезультат(Результаты, "buffer_0", 0, 30, ИзмеритьОдиночныйБуфер(0, 30));
	ДобавитьРезультат(Результаты, "buffer_1k", 1024, 30, ИзмеритьОдиночныйБуфер(1024, 30));
	ДобавитьРезультат(Результаты, "buffer_1m", 1024 * 1024, 30, ИзмеритьОдиночныйБуфер(1024 * 1024, 30));
	ДобавитьРезультат(Результаты, "two_1m", 2 * 1024 * 1024, 30, ИзмеритьДваБуфера(1024 * 1024, 30));
	ДобавитьРезультат(Результаты, "buffer_10m", 10 * 1024 * 1024, 15, ИзмеритьОдиночныйБуфер(10 * 1024 * 1024, 15));
	ДобавитьРезультат(Результаты, "batch_1000x1k", 1000 * 1024, 20, ИзмеритьСериюМалыхБуферов(1024, 1000, 20));

	Возврат Результаты;

КонецФункции

Процедура ВывестиТаблицу(Результаты)

	ШиринаСценария = 20;
	ШиринаБайт = 14;
	ШиринаПроцента = 12;
	ШиринаПовторов = 10;

	Заголовок = ДополнитьСправа("Сценарий", ШиринаСценария)
		+ ДополнитьСлева("Ожидалось", ШиринаБайт)
		+ ДополнитьСлева("Медиана", ШиринаБайт)
		+ ДополнитьСлева("Отклонение", ШиринаБайт)
		+ ДополнитьСлева("Откл., %", ШиринаПроцента)
		+ ДополнитьСлева("Мин.", ШиринаБайт)
		+ ДополнитьСлева("Макс.", ШиринаБайт)
		+ ДополнитьСлева("Повторов", ШиринаПовторов);

	Сообщить(Заголовок);
	Сообщить(ПовторитьСимвол("-", СтрДлина(Заголовок)));

	Для Каждого Результат Из Результаты Цикл
		Ожидалось = ?(
			Результат.Ожидалось = Неопределено,
			"-",
			ЦелоеЧисло(Результат.Ожидалось));
		Отклонение = ?(
			Результат.Отклонение = Неопределено,
			"-",
			ЗнаковоеЦелое(Результат.Отклонение));
		Процент = ?(
			Результат.Процент = Неопределено,
			"-",
			ЗнаковыйПроцент(Результат.Процент));

		Сообщить(
			ДополнитьСправа(Результат.Сценарий, ШиринаСценария)
			+ ДополнитьСлева(Ожидалось, ШиринаБайт)
			+ ДополнитьСлева(ЦелоеЧисло(Результат.Медиана), ШиринаБайт)
			+ ДополнитьСлева(Отклонение, ШиринаБайт)
			+ ДополнитьСлева(Процент, ШиринаПроцента)
			+ ДополнитьСлева(ЦелоеЧисло(Результат.Минимум), ШиринаБайт)
			+ ДополнитьСлева(ЦелоеЧисло(Результат.Максимум), ШиринаБайт)
			+ ДополнитьСлева(ЦелоеЧисло(Результат.Повторов), ШиринаПовторов));
	КонецЦикла;

КонецПроцедуры

Прогреть();
ВывестиТаблицу(ВыполнитьИзмерения());
